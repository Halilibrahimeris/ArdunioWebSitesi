---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, defaultLang, path } from '../i18n/utils';

// 404 tek sayfa; her iki dilde de anlaşılır olsun diye iki metni birden gösteriyoruz.
const t = useTranslations(defaultLang);
const en = useTranslations('en');
---

<BaseLayout lang={defaultLang} title={t('common.notFound')}>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-28 text-center sm:px-6">
    <p class="font-mono text-6xl font-bold" style="color: var(--color-brand-500);">404</p>

    <h1 class="mt-5 text-2xl font-bold tracking-tight" style="color: var(--text);">
      {t('common.notFound')}
    </h1>
    <p class="mt-2" style="color: var(--text-muted);">{t('common.notFoundText')}</p>

    <p class="mt-6 text-sm" style="color: var(--text-faint);">
      {en('common.notFound')} — {en('common.notFoundText')}
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={path('tr')}
        class="rounded-xl bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-600"
      >
        Türkçe ana sayfa
      </a>
      <a
        href={path('en')}
        class="rounded-xl border px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-brand-50 dark:hover:bg-brand-950/50"
        style="border-color: var(--border); color: var(--text);"
      >
        English home
      </a>
    </div>
  </div>
</BaseLayout>
