---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, path, type Lang } from '../../i18n/utils';
import { locales } from '../../i18n/ui';
import { parts, partCategoryOrder, type PartId, type PartCategory, type VoltageRisk } from '../../data/parts';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

/**
 * Her malzemeden, tek bir projede aynı anda gereken EN YÜKSEK adet.
 * Projeler arasında parçaları söküp yeniden kullandığını varsayar.
 */
interface Row {
  id: PartId;
  qty: number;
  usedIn: number[];
}

const rowMap = new Map<PartId, Row>();

for (const project of projects) {
  for (const line of project.bom) {
    const existing = rowMap.get(line.part);
    if (existing) {
      existing.qty = Math.max(existing.qty, line.qty);
      existing.usedIn.push(project.number);
    } else {
      rowMap.set(line.part, { id: line.part, qty: line.qty, usedIn: [project.number] });
    }
  }
}

const rows = [...rowMap.values()];

const grouped = partCategoryOrder
  .map((category) => ({
    category,
    rows: rows.filter((r) => parts[r.id].category === category),
  }))
  .filter((g) => g.rows.length > 0);

const riskStyle: Record<VoltageRisk, string> = {
  safe: 'background-color:#e7f6ec; color:#1c7a44;',
  caution: 'background-color:#fdf1dd; color:#8a5714;',
  danger: 'background-color:#fbe9e7; color:#963026;',
};
const riskLabel: Record<VoltageRisk, { tr: string; en: string }> = {
  safe: { tr: '3.3V güvenli', en: '3.3V safe' },
  caution: { tr: 'Dikkat', en: 'Caution' },
  danger: { tr: 'Ek devre şart', en: 'Extra circuit required' },
};

const categoryLabel = (c: PartCategory) => t(`parts.category.${c}` as const);
const qtyLabel = lang === 'tr' ? 'adet' : 'pcs';
---

<BaseLayout lang={lang} title={t('parts.title')} description={t('parts.subtitle')}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--text);">
      {t('parts.title')}
    </h1>
    <p class="mt-2 max-w-2xl" style="color: var(--text-muted);">{t('parts.subtitle')}</p>

    {
      grouped.map((group) => (
        <section class="mt-10">
          <h2 class="text-lg font-bold tracking-tight" style="color: var(--text);">
            {categoryLabel(group.category)}
          </h2>

          <ul class="mt-3 space-y-2">
            {group.rows.map((row) => {
              const part = parts[row.id];
              return (
                <li
                  class="flex flex-wrap items-start gap-3 rounded-xl border p-3.5"
                  style="border-color: var(--border); background-color: var(--surface);"
                >
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <span class="font-medium" style="color: var(--text);">
                        {part.name[lang]}
                      </span>
                      <span
                        class="rounded px-1.5 py-0.5 text-[0.68rem] font-bold"
                        style={riskStyle[part.voltageRisk]}
                      >
                        {riskLabel[part.voltageRisk][lang]}
                      </span>
                    </div>

                    {part.voltageNote && (
                      <p class="mt-1 text-xs leading-relaxed" style="color: var(--text-muted);">
                        {part.voltageNote[lang]}
                      </p>
                    )}

                    <p class="mt-1.5 text-xs" style="color: var(--text-faint);">
                      {t('parts.usedIn')}:{' '}
                      {row.usedIn.map((n, i) => (
                        <>
                          {i > 0 && ', '}
                          <a
                            href={path(lang, 'projects', projects[n - 1].slug[lang])}
                            class="underline underline-offset-2"
                          >
                            #{n}
                          </a>
                        </>
                      ))}
                    </p>
                  </div>

                  <span
                    class="shrink-0 rounded-lg px-2.5 py-1 text-sm font-semibold tabular-nums whitespace-nowrap"
                    style="background-color: var(--bg-inset); color: var(--text-muted);"
                  >
                    {row.qty} {qtyLabel}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
