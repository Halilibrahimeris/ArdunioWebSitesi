---
import { useTranslations, path, type Lang } from '../i18n/utils';
import Badges from './Badges.astro';
import type { Project } from '../data/projects';

interface Props {
  lang: Lang;
  project: Project;
  title: string;
  summary: string;
}

const { lang, project, title, summary } = Astro.props;
const t = useTranslations(lang);

const href = path(lang, 'projects', project.slug[lang]);

const accent: Record<Project['category'], string> = {
  offline: 'var(--color-offline-500)',
  bridge: 'var(--color-brand-500)',
  wifi: 'var(--color-wifi-500)',
  ai: 'var(--color-ai-500)',
};
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border transition-all duration-200 hover:-translate-y-0.5"
  style="border-color: var(--border); background-color: var(--surface); box-shadow: var(--shadow-card);"
  data-category={project.category}
  data-difficulty={project.difficulty}
>
  <!-- Kategori şeridi -->
  <div class="h-1 w-full" style={`background-color: ${accent[project.category]};`}></div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2.5">
      <span
        class="grid h-7 w-7 shrink-0 place-items-center rounded-lg text-xs font-bold tabular-nums"
        style={`background-color: color-mix(in srgb, ${accent[project.category]} 14%, transparent); color: ${accent[project.category]};`}
      >
        {project.number}
      </span>
      <Badges lang={lang} kind="category" value={project.category} size="sm" />
      <Badges lang={lang} kind="difficulty" value={project.difficulty} size="sm" />
    </div>

    <h3 class="mt-3 text-lg font-semibold leading-snug tracking-tight" style="color: var(--text);">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {title}
      </a>
    </h3>

    <p class="mt-2 flex-1 text-sm leading-relaxed" style="color: var(--text-muted);">
      {summary}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs" style="color: var(--text-faint);">
      <span class="inline-flex items-center gap-1">
        <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7" />
          <path d="M12 7.5V12l2.8 1.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        {project.durationMin} {t('time.minutes')}
      </span>

      {
        project.bom.every((l) => l.reusedFrom) && (
          <span class="font-medium" style="color: var(--color-brand-600);">
            {t('project.noExtraParts')}
          </span>
        )
      }
      {project.needsCamera && <span>{t('project.needsCamera')}</span>}
      {project.needsInternet && <span>{t('project.needsInternet')}</span>}
    </div>
  </div>
</article>
