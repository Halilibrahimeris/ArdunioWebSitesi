---
/**
 * Fotoğraf yer tutucusu / Photo placeholder.
 * Kullanıcı kendi çektiği fotoğrafı public/photos/ altına koyup `src` verince
 * yer tutucu gerçek görsele dönüşür.
 */
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** public/photos/ altındaki dosya adı. Verilmezse yer tutucu görünür. */
  src?: string;
  alt?: string;
  caption?: string;
}

const { lang, src, alt = '', caption } = Astro.props;
const t = useTranslations(lang);
---

<figure class="my-6">
  {
    src ? (
      <img
        src={`/photos/${src}`}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="w-full rounded-xl border"
        style="border-color: var(--border);"
      />
    ) : (
      <div
        class="grid min-h-44 place-items-center rounded-xl border-2 border-dashed px-6 py-10 text-center"
        style="border-color: var(--border); background-color: var(--bg-subtle);"
      >
        <div>
          <svg viewBox="0 0 24 24" fill="none" class="mx-auto h-8 w-8" style="color: var(--text-faint);" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6" />
            <circle cx="8.75" cy="10" r="1.6" stroke="currentColor" stroke-width="1.6" />
            <path d="m4 17 4.5-4.2a2 2 0 0 1 2.7 0L15 16.5m0 0 2-1.8a2 2 0 0 1 2.7 0L21 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <p class="mt-3 text-sm font-medium" style="color: var(--text-muted);">{t('photo.placeholder')}</p>
          <p class="mt-1 font-mono text-xs" style="color: var(--text-faint);">{t('photo.hint')}</p>
        </div>
      </div>
    )
  }
  {caption && <figcaption class="mt-2 text-center text-xs" style="color: var(--text-faint);">{caption}</figcaption>}
</figure>
