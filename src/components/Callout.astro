---
/**
 * Uyarı kutusu / Callout box.
 *
 * `voltage` türü bu sitenin tekrar eden öğretim motifi: kart 3.3V lojik kullanır,
 * kullandığımız klasik modüllerin çoğu 5V dünyasından gelir.
 * The `voltage` variant is this site's recurring lesson: the board is 3.3V logic
 * while most classic modules come from the 5V world.
 */
import { useTranslations, path, type Lang } from '../i18n/utils';

type Variant = 'tip' | 'info' | 'warning' | 'danger' | 'voltage';

interface Props {
  lang: Lang;
  variant?: Variant;
  title?: string;
  /** 3.3V rehberine bağlantı göster / Show a link to the 3.3V guide. */
  linkToGuide?: boolean;
}

const { lang, variant = 'info', title, linkToGuide = false } = Astro.props;
const t = useTranslations(lang);

const config: Record<Variant, { bg: string; border: string; fg: string; icon: string; key: Parameters<typeof t>[0] }> = {
  tip:     { bg: '#e7f6ec', border: '#8fd0aa', fg: '#155f36', icon: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.4.3.6.8.6 1.3v.3h5.8v-.3c0-.5.2-1 .6-1.3A6 6 0 0 0 12 3Z', key: 'callout.tip' },
  info:    { bg: '#e5f2fc', border: '#8ec4e8', fg: '#0a5580', icon: 'M12 16v-5M12 8h.01M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z', key: 'callout.info' },
  warning: { bg: '#fdf1dd', border: '#e8bd76', fg: '#8a5714', icon: 'M12 9v4M12 17h.01M10.3 3.9 2.5 17.4A2 2 0 0 0 4.2 20.4h15.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z', key: 'callout.warning' },
  danger:  { bg: '#fbe9e7', border: '#e5a49b', fg: '#963026', icon: 'M12 9v4M12 17h.01M10.3 3.9 2.5 17.4A2 2 0 0 0 4.2 20.4h15.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z', key: 'callout.danger' },
  voltage: { bg: '#fdecea', border: '#e09a90', fg: '#9d2f24', icon: 'M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z', key: 'callout.voltage' },
};

const c = config[variant];
const heading = title ?? t(c.key);
---

<aside
  class="callout my-6 rounded-xl border-l-4 px-4 py-3.5"
  style={`background-color:${c.bg}; border-left-color:${c.border}; color:${c.fg};`}
  role={variant === 'danger' || variant === 'voltage' ? 'alert' : undefined}
>
  <div class="flex gap-3">
    <svg viewBox="0 0 24 24" fill="none" class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true">
      <path d={c.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <div class="min-w-0 flex-1">
      <p class="text-sm font-bold">{heading}</p>
      <div class="callout-body mt-1 text-sm leading-relaxed">
        <slot />
      </div>
      {
        linkToGuide && (
          <a
            href={path(lang, 'guides', lang === 'tr' ? '3v3-guvenligi' : '3v3-safety')}
            class="mt-2 inline-flex items-center gap-1 text-sm font-semibold underline underline-offset-2"
          >
            {lang === 'tr' ? '3.3V rehberini oku' : 'Read the 3.3V guide'}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</aside>

<style>
  .callout-body :global(p + p) { margin-top: 0.6em; }
  .callout-body :global(ul) { list-style: disc; padding-left: 1.15rem; margin-top: 0.4em; }
  .callout-body :global(li + li) { margin-top: 0.25em; }
  .callout-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgb(0 0 0 / 0.06);
    padding: 0.08em 0.35em;
    border-radius: 4px;
  }
  .callout-body :global(a) { text-decoration: underline; text-underline-offset: 2px; }
  .callout-body :global(strong) { font-weight: 700; }

  /* Karanlık modda okunabilirlik / Keep contrast in dark mode. */
  :global(.dark) .callout { filter: brightness(0.9) saturate(0.9); }
</style>
